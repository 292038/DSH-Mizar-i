/* The Live Activity: the Dynamic Island, and the card on the Lock Screen. */

/* Shown when every session has stopped. The island draws a green check for
   this; the card draws the check and these words, because a card holding only
   the app's name reads as a card that failed to load. */
"Every session has finished" = "Every session has finished";

/* What the counting clock on the right of the island is. VoiceOver only: the
   number is drawn by the system's timer, and a bare duration announced with no
   noun is a number about nothing. */
"Running time" = "Running time";
